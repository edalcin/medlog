# MedLog v2 — Environment Variables
# Copy this file to .env and fill in the values

# SQLite database path (file: prefix required)
DATABASE_URL=file:/app/data/db/medlog.sqlite

# Directory for uploaded files
FILES_PATH=/app/data/uploads

# Session secret key (generate with: openssl rand -base64 32)
SESSION_SECRET=generate-with-openssl-rand-base64-32

# Server port
PORT=3000

# First-boot admin credentials (only required when no users exist yet)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme

# Set to "true" in production (HTTPS required for Secure cookies)
SESSION_SECURE=false

# Set to "true" when behind a trusted reverse proxy (Cloudflare Tunnel, nginx, etc.)
# Enables CF-Connecting-IP / X-Forwarded-For for accurate IP detection in rate limiting
TRUST_PROXY=false
